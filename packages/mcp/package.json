{
  "name": "@roadmap/mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "roadmap-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@roadmap/core": "0.1.0",
    "commander": "^14.0.0",
    "zod": "^4.0.10"
  }
}
