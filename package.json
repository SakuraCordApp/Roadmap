{
  "name": "sakuracord-roadmap",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable, self-hostable roadmap management with Cloudflare, Discord, MCP, and Codex integration.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @roadmap/core && npm run build --workspace @roadmap/mcp && npm run build --workspace @roadmap/web && npm run build --workspace @roadmap/worker && npm run build --workspace @roadmap/cli",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "npm run dev --workspace @roadmap/worker",
    "dev:web": "npm run dev --workspace @roadmap/web",
    "discord:configure-forums": "node scripts/configure-discord-forums.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "roadmap": "node packages/cli/dist/index.js",
    "migrate:local": "wrangler d1 migrations apply sakuracord-roadmap --local",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "miniflare": "^4.20260722.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.26.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
