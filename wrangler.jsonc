{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakuracord-roadmap",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "20aea060f70461a418cf31bc70b79cdc",
  "routes": [
    { "pattern": "roadmap.sakuracord.app", "custom_domain": true },
    { "pattern": "tracker.sakuracord.app", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakuracord-roadmap",
      "database_id": "dedb4e6e-2de8-4d9c-8405-fe7fa1e08ffd",
    },
  ],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "sakuracord-issues" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "sakuracord-discord-reports" }],
    "consumers": [
      {
        "queue": "sakuracord-discord-reports",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGatewayObject"] },
    { "tag": "v2", "deleted_classes": ["DiscordGatewayObject"] },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "WEBSITE_URL": "https://sakuracord.app",
    "HUB_URL": "https://roadmap.sakuracord.app",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
